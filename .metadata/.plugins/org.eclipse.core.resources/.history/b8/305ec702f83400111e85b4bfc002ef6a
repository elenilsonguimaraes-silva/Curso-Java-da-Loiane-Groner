package com.elenilson.estruturasDeDadosJava.pilha.labs;

public class Livro {
	private String nome;
	private String isbn;
	private String anoLancamento;
	private String autor;
	
	public Livro() {
		super();
	}
	
	public Livro(String nome, String isbn, String anoLancamento, String autor) {
		super();
		this.nome = nome;
		this.isbn = isbn;
		this.anoLancamento = anoLancamento;
		this.autor = autor;
	}
	
	
	
}
