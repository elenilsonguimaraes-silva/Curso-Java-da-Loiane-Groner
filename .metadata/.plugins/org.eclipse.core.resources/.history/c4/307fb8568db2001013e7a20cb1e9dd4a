package com.elenilson.aula19;

import java.util.Scanner;

public class Aula19Exercicio18 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		Scanner scan = new Scanner(System.in);
		
		System.out.println("Vetores:");
		int[] vetorA = new int[10];
		int menor = Integer.MIN_VALUE;
		int maior = Integer.MAX_VALUE;
		
		System.out.println("Vetor de Idades");
		for(int i = 0; i < vetorA.length ; i++){
			System.out.println("Digite a idade do vetorA na posição vetorA[" + i +"]:");
			vetorA[i] = scan.nextInt();
			if(maior > vetorA[i]) {
				maior = vetorA[i];
				System.out.println(" Valor do vetorA na posição vetorA[" + i +"]");
			}
			if(menor < vetorA[i]) {
				menor = vetorA[i];
				System.out.println(" Valor do vetorA na posição vetorA[" + i +"]");
			}
		}
		System.out.println("A maior idade é: " + maior);
		
		
		System.out.println("A menor idade é: " + menor);
		


	}

}
