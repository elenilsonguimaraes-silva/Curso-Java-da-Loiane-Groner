	public static String decimalBinario(int numero) {
		
		Stack<Integer>  pilha = new Stack<>();
		String numeroBinario = "";
		int resto;
		
		while(numero > 0) {
			resto = numero % 2;
			pilha.push(resto);
			numero /= numero;
		}
		
		
	}

