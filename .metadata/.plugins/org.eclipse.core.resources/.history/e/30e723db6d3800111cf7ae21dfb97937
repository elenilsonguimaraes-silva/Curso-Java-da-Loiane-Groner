package com.elenilson.estruturasDeDadosJava.pilha.labs;

import com.elenilson.estruturasDeDadosJava.pilha.Pilha;

public class Exercicio06 {

	public static void main(String[] args) {
		Pilha<Character> pilha = new Pilha<Character>();
		Pilha<Character> pilhaDireita = new Pilha<Character>();
		Pilha<Character> pilhaEsquerda = new Pilha<Character>();
		
		//String palavra = "((A+B) ou A+B(";
		String palavra = ")A+B(-C ou (A+B)) - (C + D";
		//String palavra = "((A + B) + D)";
		String palavra2 = "";
		String desempilha = "";
		
		for(int i = 0; i < palavra.length(); i++) {
			if(palavra.charAt(i) == '('){
				pilhaDireita.empilha(palavra.charAt(i));
				pilha.empilha(palavra.charAt(i));
				System.out.println("Empilhando o caracter" + palavra.charAt(i) + " na pilha esquerda");
			}
			if(palavra.charAt(i) == ')'){		
				System.out.println("Empilhando o caracter" + palavra.charAt(i) + " na pilha direita");
				palavra2 += palavra.charAt(i);
				pilha.empilha(palavra.charAt(i));
			}
			
		}
		
		palavra = "";
		
		while(!pilhaDireita.estaVazia()) {
			
			palavra += pilhaDireita.desempilha();
			
		}
		while(!pilhaEsquerda.estaVazia()) {
			palavra2  += pilhaEsquerda.desempilha();
			
		}
		while(!pilha.estaVazia()) {
			desempilha  += pilha.desempilha();
			
		}
		
		int j = desempilha.length();
		j--;
		System.out.println("O valor de j é " + j);
		System.out.println("Pilha direita: " + palavra);
		System.out.println("Pilha esquerda: " + palavra2);
		System.out.println("Desempilha: " + desempilha);
		if(desempilha.length() % 2 == 0) {
			for(int i = 0; i < (palavra.length()); i++) {
				if(desempilha.charAt(j) == '(' && desempilha.charAt(i) == ')') {
					System.out.println("Está Ok");
				}else {
					System.out.println("Violam a condição 2");
					break;
				}
				j--;
			}
		}else {
			System.out.println("Violam a condiação 1!");
		}
		
	}
}